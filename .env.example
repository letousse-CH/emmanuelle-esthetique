# ─────────────────────────────────────────────────────────────────────────────
# Variables d'environnement — copier en .env.local et compléter, ou utiliser
# `npm run setup` pour être guidé.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (base de données + auth) — requis ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : ne jamais exposer côté client. Utilisée par les routes API
# et le script d'installation pour écrire dans Supabase.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://votre-domaine.com

# ── Stripe (paiement des inscriptions événements) ───────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Cloudflare R2 (stockage des médias) ─────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
NEXT_PUBLIC_R2_PUBLIC_URL=

# ── E-mail transactionnel (Resend) ──────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# E-mail destinataire du formulaire de contact
CONTACT_EMAIL=
# Secret de signature des liens de désinscription (HMAC). Générer une valeur
# aléatoire longue : `openssl rand -hex 32`. Tant qu'il est vide, /api/welcome-email
# et /api/send-newsletter refusent d'envoyer (un lien signé avec une clé vide
# serait forgeable par n'importe qui).
UNSUB_SECRET=

# ── Génération IA d'article (module optionnel) ──────────────────────────────
ANTHROPIC_API_KEY=

# ── Avis Google (optionnel) ──────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# ── Tâches planifiées (auto-publication d'articles, séquences e-mail) ───────
# Secret partagé requis par les endpoints /api/cron/* — sans lui, ils
# refusent l'accès (fail closed).
CRON_SECRET=

# ── SEO ───────────────────────────────────────────────────────────────────────
BING_INDEXNOW_KEY=

# ── Sécurité des routes d'administration ────────────────────────────────────
# E-mails autorisés à utiliser l'admin et ses routes API, séparés par des virgules (vide = tout compte connecté, à éviter).
ADMIN_EMAILS=
# Secret des appels serveur-à-serveur (cron, autopilote) via l'en-tête x-internal-secret ; générer avec `openssl rand -hex 32` (à défaut, CRON_SECRET est utilisé).
INTERNAL_API_SECRET=

# ── LinkedIn (connexion OAuth pour la publication) ──────────────────────────
# Identifiant client de l'application LinkedIn (public, visible dans l'URL d'autorisation).
LINKEDIN_CLIENT_ID=
# Secret client de l'application LinkedIn : ne jamais le mettre dans le code.
LINKEDIN_CLIENT_SECRET=
